{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>holidayworking/renovate-config"],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "vite-plus",
      "matchPackageNames": ["vite", "vite-plus"]
    },
    {
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    }
  ]
}
