{ inputs, ... }:
{
  imports = [ (inputs.treefmt-nix.flakeModule or { }) ];

  flake-file.inputs.treefmt-nix = {
    url = "github:numtide/treefmt-nix";
    inputs.nixpkgs.follows = "nixpkgs";
  };

  perSystem =
    { lib, pkgs, ... }:
    let
      workflows = [
        ".github/workflows/*.yaml"
        ".github/workflows/*.yml"
      ];
    in
    {
      treefmt = {
        programs = {
          deadnix.enable = true;
          nixfmt.enable = true;
          shellcheck.enable = true;
          shfmt.enable = true;
          stylua.enable = true;
        };

        projectRootFile = "flake.nix";

        settings = {
          formatter = {
            ghalint = {
              command = lib.getExe pkgs.ghalint;
              includes = workflows;

              options = [ "run" ];
            };

            jactionlint = {
              command = lib.getExe pkgs.jactionlint;
              includes = workflows;

              options = [
                # Unlike actionlint, the nixpkgs package does not wrap these, and
                # silently skips the checks when they are not on PATH.
                "--shellcheck=${lib.getExe pkgs.shellcheck}"
                "--pyflakes=${lib.getExe pkgs.python3Packages.pyflakes}"
              ];
            };
          };

          # Generated by nvfetcher.
          global.excludes = [ "nix/sources/generated/*" ];
        };
      };
    };
}
