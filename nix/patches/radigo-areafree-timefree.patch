+
+// isAreaFree reports whether the client plays a station outside the current
+// area as a radiko premium member.
+func isAreaFree(client *radiko.Client) bool {
+	return client.AreaID() != currentAreaID
+}
+
+// timeshiftPlaylistType returns "c" for the area-free playback, which rejects
+// "b" with 403.
+func timeshiftPlaylistType(client *radiko.Client) string {
+	if isAreaFree(client) {
+		return "c"
+	}
+	return "b"
+}
